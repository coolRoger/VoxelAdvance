{
    "$schema": "https://biomejs.dev/schemas/2.5.11/schema.json",
    "vcs": {
        "enabled": true,
        "clientKind": "git",
        "useIgnoreFile": true
    },
    "files": {
        "ignoreUnknown": true,
        "includes": [
            "**",
            "!node_modules",
            "!.next",
            "!dist",
            "!build",
            "!solid-env.d.ts",
            "!file-routes.d.ts"
        ]
    },
    "formatter": {
        "enabled": true,
        "indentStyle": "space",
        "indentWidth": 4,
        "attributePosition": "multiline",
        "lineWidth": 80
    },
    "css": {
        "parser": {
            "tailwindDirectives": true
        }
    },
    "linter": {
        "enabled": true,
        "rules": {
            "correctness": {
                "useHookAtTopLevel": "off"
            },
            "suspicious": {
                "noUnknownAtRules": "off",
                "noExplicitAny": "off",
                "noConfusingVoidType": "off"
            },
            "complexity": {
                "noStaticOnlyClass": "off",
                "noBannedTypes": "off",
                "noImportantStyles": "off",
                "noArguments": "warn"
            },
            "a11y": {
                "noStaticElementInteractions": "off",
                "useKeyWithClickEvents": "off"
            },
            "style": {
                "noNonNullAssertion": "off"
            }
        }
    },
    "assist": {
        "actions": {
            "source": {
                "organizeImports": "on"
            }
        }
    }
}
